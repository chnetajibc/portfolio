{
  // CANONICAL CONFIG: src/config.ts — single source of truth for all tunables
  // - ratelimits must stay synced with src/config.ts RATE_LIMITS
  // - send_email destination must match src/config.ts CONTACT_CONFIG.TO
  // - vars are optional overrides only; defaults come from src/config.ts ORIGINS/DEFAULTS
  //   (ALLOWED_ORIGIN defaults to ORIGINS.PROD in production, ORIGINS.DEV when ENVIRONMENT=development)
  "name": "portfolio-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMIT", "namespace_id": "1", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHAT_RATE_LIMIT_HOUR", "namespace_id": "2", "simple": { "limit": 20, "period": 60 } },
    { "name": "CHAT_RATE_LIMIT_DAY", "namespace_id": "3", "simple": { "limit": 40, "period": 60 } },
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "4", "simple": { "limit": 5, "period": 60 } },
    { "name": "CONTACT_RATE_LIMIT_HOUR", "namespace_id": "5", "simple": { "limit": 20, "period": 60 } },
    { "name": "CONTACT_RATE_LIMIT_DAY", "namespace_id": "6", "simple": { "limit": 40, "period": 60 } }
  ],
  "vars": {},
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "chnetajibc@gmail.com"
    }
  ]
}
